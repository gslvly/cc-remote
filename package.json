{
  "name": "cc-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "手机端远程控制本机 Claude Code 的轻量 Web UI",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "CCR_HOST=127.0.0.1 bun --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "bun test server web",
    "check": "bun run typecheck && bun test server web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "diff": "^9.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "playwright-core": "1.58.2",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
